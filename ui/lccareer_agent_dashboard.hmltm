<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CAREER_AGENT_SYSTEM v4.2.0 — Vault Auto-Apply & Tailored Resume Studio</title>
  <style>
    body { font-family: system-ui, sans-serif; background-color: #0f172a; color: #f8fafc; margin: 0; padding: 24px; }
    .container { max-width: 1200px; margin: 0 auto; }
    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155; padding-bottom: 16px; margin-bottom: 24px; }
    .title { font-size: 24px; font-weight: bold; color: #818cf8; }
    .subtitle { color: #94a3b8; font-size: 14px; }
    .btn { cursor: pointer; border: none; border-radius: 8px; padding: 10px 16px; font-weight: 600; font-size: 14px; }
    .btn-primary { background-color: #4f46e5; color: white; }
    .btn-success { background-color: #059669; color: white; }
    .btn-secondary { background-color: #334155; color: white; }
    .btn-sm { padding: 6px 12px; font-size: 12px; }
    .grid { display: grid; grid-template-columns: 1fr 2fr; gap: 24px; }
    .card { background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 20px; margin-bottom: 16px; }
    .field { margin-bottom: 12px; }
    .label { font-size: 12px; color: #94a3b8; display: block; margin-bottom: 4px; }
    .input { width: 100%; background: #0f172a; border: 1px solid #334155; border-radius: 6px; color: #e2e8f0; padding: 8px; box-sizing: border-box; }
    .badge { display: inline-block; padding: 4px 8px; border-radius: 9999px; font-size: 12px; font-weight: bold; }
    .badge-success { background: #064e3b; color: #6ee7b7; border: 1px solid #10b981; }
    .badge-pending { background: #78350f; color: #fde68a; border: 1px solid #f59e0b; }
    .flex { display: flex; gap: 8px; align-items: center; }
    .flex-between { justify-content: space-between; }
    .log-box { font-family: monospace; font-size: 12px; background: #020617; border: 1px solid #1e293b; color: #34d399; padding: 12px; border-radius: 6px; height: 100px; overflow-y: auto; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div>
        <div class="title">CAREER_AGENT_SYSTEM v4.2.0 — Vault Auto-Apply & Tailored Resume Studio</div>
        <div class="subtitle">Personal Vault-Driven Job Automation Engine & ATS Resume Generator</div>
      </div>
      <div class="flex">
        <button onclick="autoApplyAll()" class="btn btn-primary">Auto-Apply All via Vault</button>
        <button onclick="saveAndBatchRun()" class="btn btn-success">Save Vault & Run Auto-Apply Batch Now</button>
      </div>
    </div>

    <div class="grid">
      <div class="card">
        <h3 style="color:#34d399; border-bottom:1px solid #334155; padding-bottom:8px;">Personal Vault (user_profile_v1.json)</h3>
        <div class="field">
          <label class="label">Full Name</label>
          <input id="vault-name" value="Kodimurthy Bhalavardan (Balu Kodimurthy)" class="input">
        </div>
        <div class="field">
          <label class="label">Phone</label>
          <input id="vault-phone" value="+91 8688031654" class="input">
        </div>
        <div class="field">
          <label class="label">Education</label>
          <input id="vault-edu" value="B.Tech CSE Roll 26MLA05037 AP ECET Rank 3302 @ MITS" class="input">
        </div>
        <div class="field">
          <label class="label">Experience</label>
          <input id="vault-exp" value="3-Month Software Developer Intern @ Aditya Birla Garments Ltd — Built TIMS & File Shelf Tracker" class="input">
        </div>
        <div class="field">
          <label class="label">Availability</label>
          <input id="vault-avail" value="4 hrs/day Remote" class="input">
        </div>
        <div id="status-log" class="log-box">
          [Vault Loaded]: user_profile_v1.json ready.
        </div>
      </div>

      <div>
        <h3 style="color:#c7d2fe; margin-bottom:16px;">Target Roles & Vault Matching</h3>
        <div id="roles-container"></div>
      </div>
    </div>
  </div>

  <script>
    const targetRoles = [
      { company: 'Gridbricks', role: 'Full Stack Engineer', match_score: 92 },
      { company: 'RavelCode', role: 'Backend Developer', match_score: 88 },
      { company: 'Langslide', role: 'AI Applications Developer', match_score: 85 },
      { company: 'Vortizo AI', role: 'Python Software Intern', match_score: 95 },
      { company: 'Exaful', role: 'Junior Systems Engineer', match_score: 82 },
      { company: 'The AI Signal', role: 'Frontend & UI Intern', match_score: 89 },
      { company: 'IntelleQAcademy', role: 'Software Tooling Developer', match_score: 84 },
      { company: 'Timbre', role: 'Automation Engineer', match_score: 90 }
    ];

    const appliedState = {};

    function log(msg) {
      const el = document.getElementById('status-log');
      el.innerHTML += '<br>> ' + msg;
      el.scrollTop = el.scrollHeight;
    }

    function renderRoles() {
      const container = document.getElementById('roles-container');
      container.innerHTML = targetRoles.map(job => {
        const isApplied = appliedState[job.company] || (job.match_score >= 80 && appliedState.allApplied);
        const statusBadge = isApplied 
          ? '<span class="badge badge-success">Auto-Applied via Vault ✓</span>' 
          : '<span class="badge badge-pending">Pending (' + job.match_score + '%)</span>';

        return `
          <div class="card flex flex-between">
            <div>
              <div class="flex">
                <strong>${job.company}</strong>
                <span style="font-size:12px; color:#a5b4fc;">[Score: ${job.match_score}%]</span>
                ${statusBadge}
              </div>
              <div style="font-size:14px; color:#94a3b8; margin-top:4px;">${job.role}</div>
            </div>
            <div class="flex">
              <button onclick="applyVault('${job.company}')" class="btn btn-primary btn-sm">Apply via Vault</button>
              <button onclick="downloadResume('${job.company}')" class="btn btn-secondary btn-sm">Download Resume HTML</button>
              <button onclick="copyPacket('${job.company}')" class="btn btn-secondary btn-sm">Copy Application Packet</button>
            </div>
          </div>
        `;
      }).join('');
    }

    function applyVault(company) {
      appliedState[company] = true;
      log('Applied to ' + company + ' via Vault user_profile_v1.json.');
      log('Generated ATS_Tailored_Resume_' + company + '.pdf');
      renderRoles();
    }

    function downloadResume(company) {
      log('Generated ATS_Tailored_Resume_' + company + '.pdf');
      alert('Downloading ATS_Tailored_Resume_' + company + '.pdf');
    }

    function copyPacket(company) {
      log('Copied Vault Application Packet for ' + company);
      alert('Packet copied for ' + company);
    }

    function autoApplyAll() {
      appliedState.allApplied = true;
      targetRoles.forEach(r => {
        if (r.match_score >= 80) {
          appliedState[r.company] = true;
          log('Auto-Applied via Vault ✓ -> ' + r.company + ' (Match: ' + r.match_score + '%)');
          log('Generated ATS_Tailored_Resume_' + r.company + '.pdf');
        }
      });
      renderRoles();
    }

    function saveAndBatchRun() {
      log('Saved user_profile_v1.json to Vault.');
      autoApplyAll();
    }

    renderRoles();
  </script>
</body>
</html>
